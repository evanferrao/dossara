# ==========================================
# Dossara Environment Configuration Template
# Copy this file to .env.local for local development
# ==========================================

# Allowed CORS Origins for Cloudflare Worker & API
# Comma-separated list of allowed origins. Supports wildcard subdomains (e.g. *.pages.dev).
# Use "*" for unrestricted local development.
ALLOWED_ORIGINS="https://dossara.yourdomain.com,https://dossara.pages.dev,https://*.dossara.pages.dev"

# Cloudflare Worker URL (Public API Gateway for Chat & Web Search)
NEXT_PUBLIC_WORKER_URL="https://dossara-proxy.your-account.workers.dev"

# LLM Models Configuration (comma-separated list for Model Selector)
NEXT_PUBLIC_MODELS="openai/gpt-oss-20b,openai/gpt-oss-120b"

# Rate Limit Control (Requests per IP per day on Worker proxy)
MAX_CHAT_PER_IP_PER_DAY=5

# Worker Secrets (Set in Cloudflare Worker via wrangler secret or .dev.vars)
# GROQ_API_KEY="gsk_..."
# TAVILY_API_KEY="tvly-..."

# Local In-Browser Embedding & RAG Pipeline Settings
EMBEDDING_MODEL="Xenova/all-MiniLM-L6-v2"
EMBEDDING_DIMENSIONS=384
CHUNK_MAX_TOKENS=256
CHUNK_TOKEN_OVERLAP=25
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
PAGES_PER_BATCH=10
TOP_K_CHUNKS=5
HISTORY_LIMIT=10
