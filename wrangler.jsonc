{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dossara-proxy",
	"compatibility_date": "2026-08-15",
	"main": "cloudflare/workers.js",
	"vars": {
		"MAX_CHAT_PER_IP_PER_DAY": "50",
		// Comma-separated origin allowlist. Supports wildcard subdomains (e.g. "*.dossara.pages.dev").
		// Set to "*" for local development only.
		"ALLOWED_ORIGINS": "https://dossara.evanferrao.com,https://dossara.evanferrao.win,https://dossara.boxinaclosedbox.win,https://dossara.pages.dev,https://*.dossara.pages.dev"
	},
	"kv_namespaces": [
		{
			"binding": "RATE_LIMIT_KV",
			"id": "2608adcd1cc5489490114369b50c29bb"
		}
	]
}